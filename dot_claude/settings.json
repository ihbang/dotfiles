{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout:*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(kubectl get)",
      "Bash(helm list)",
      "Read",
      "mcp__claude_ai_Atlassian__getConfluencePageDescendants",
      "mcp__claude_ai_Atlassian__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian__getConfluencePage",
      "Bash(kubectl get:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl describe:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git remote get-url origin 2>/dev/null | grep -q \"a2sys-platform\" && jq -Rs \"{hookSpecificOutput:{hookEventName:\\\"SessionStart\\\",additionalContext:.}}\" \"$HOME/.claude/rules/a2sys-dev-rules.md\" || true",
            "timeout": 10,
            "statusMessage": "사내 개발 규정 확인 중"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/wiki-match.sh\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "위키 관련 페이지 확인 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -Eq '(^|[;&|] *)gh +pr +create' && git remote get-url origin 2>/dev/null | grep -q \"a2sys-platform\" && awk \"/^## PR\\$/,/^## Review\\$/\" \"$HOME/.claude/rules/a2sys-dev-rules.md\" | jq -Rs \"{hookSpecificOutput:{hookEventName:\\\"PreToolUse\\\",additionalContext:(\\\"[A2SYS rules] before creating a PR — full text: ~/.claude/rules/a2sys-dev-rules.md\\n\\\" + .)}}\" || true",
            "if": "Bash(gh pr create*)",
            "timeout": 10,
            "statusMessage": "PR 규정 확인 중"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enabledPlugins": {
    "documents@a2sys-claude": true,
    "humanizer@a2sys-claude": true,
    "mattpocock-skills@claude-plugins-official": true,
    "core@a2sys-claude": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "wdw@a2sys-claude": true
  },
  "extraKnownMarketplaces": {
    "a2sys-claude": {
      "source": {
        "source": "github",
        "repo": "a2sys-platform/claude-plugins"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "Korean",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "docker",
      "git"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": false,
  "wheelScrollAccelerationEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": false
}
