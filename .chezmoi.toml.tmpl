{{- $email := promptStringOnce . "email" "Email address for github account" -}}
{{- $wikiPath := promptStringOnce . "wikiPath" "Path to the personal wiki repository" (printf "%s/Workspace/Wiki" .chezmoi.homeDir) -}}

[git]
autoCommit = true
autoPush = true

[data]
email = {{ $email | quote }}
editor = "nvim"
wikiPath = {{ $wikiPath | quote }}
