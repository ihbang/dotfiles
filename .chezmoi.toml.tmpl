{{- $email := promptStringOnce . "email" "Email address for github account" -}}

[git]
autoCommit = true
autoPush = true

[data]
email = {{ $email | quote }}
editor = "nvim"
{{/* The personal wiki is not configurable: it always lives under ~/Documents, and
     run_once_after_10_clone-wiki.sh clones it there. Kept as a data value because
     the wiki-match hook resolves it with `chezmoi execute-template`. */ -}}
wikiPath = {{ printf "%s/Documents/llm-wiki" .chezmoi.homeDir | quote }}
